<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Debit Alert</title>
    <style>
        body { font-family: Arial, sans-serif; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; }
        .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; text-align: center; }
        .content { padding: 30px; background: #f9f9f9; }
        .amount { font-size: 32px; color: #dc3545; font-weight: bold; text-align: center; }
        .details { background: white; padding: 20px; border-radius: 10px; margin: 20px 0; }
        .footer { font-size: 12px; color: #718096; text-align: center; margin-top: 20px; border-top: 1px solid #e0e0e0; padding-top: 20px; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>NOVA BANK</h1>
    </div>
    <div class="content">
        <h2>Debit Alert</h2>
        <p>Dear {{ .FirstName }} {{ .LastName }},</p>
        <p>Your account has been debited with:</p>
        <div class="amount">{{ .Currency }} {{ .Amount }}</div>
        <div class="details">
            <p><strong>Transaction Reference:</strong> {{ .Reference }}</p>
            <p><strong>Account:</strong> {{ .AccountNumber }}</p>
            <p><strong>Description:</strong> {{ .Description }}</p>
            <p><strong>Date:</strong> {{ .Date }}</p>
            <p><strong>Current Balance:</strong> {{ .Balance }}</p>
        </div>
        <p>If you did not authorize this transaction, please contact us immediately.</p>
    </div>
    <div class="footer">
        <p>Thank you for banking with us!</p>
        <p>© 2026 Nova Bank. All rights reserved.</p>
    </div>
</div>
</body>
</html>