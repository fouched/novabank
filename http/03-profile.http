### Get User Profile
GET {{host}}/api/users/profile
Authorization: Bearer {{jwt}}

> {%
    client.test("Status is 200 OK", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("User has at least one account", function () {
        const accounts = response.body.accounts;
        client.assert(Array.isArray(accounts) && accounts.length > 0, "No accounts found on profile");

        // Save the dynamic account number for later requests
        client.global.set("account_number", accounts[0].account_number);
    });
%}