### Get Account By Number
# @name Get Account By Number
GET {{host}}/api/accounts/{{account_number}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

> {%
    client.test("Status is 200 OK", function () {
        client.assert(response.status === 200, "Expected status 200, got " + response.status);
    });

    client.test("Retrieved correct account", function() {
        const expectedAccNum = client.global.get("account_number");
        const accNum = response.body.account_number;

        client.assert(accNum === expectedAccNum, "Expected account number: " + expectedAccNum + " got: " + accNum);
    });
%}

### Get Account By Incorrect Number
# @name Get Account By Incorrect Number
GET {{host}}/api/accounts/00000
Authorization: Bearer {{jwt}}
Content-Type: application/json

> {%
    client.test("Status is 404", function () {
        client.assert(response.status === 404, "Response status is not 404 - not found");
    });
%}

### Search Accounts By Email
# @name Search Accounts By Email
POST {{host}}/api/accounts/search
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "email": "{{email}}"
}

> {%
    client.test("Status is 200 OK", function () {
        client.assert(response.status === 200, "Expected status 200, got:" + response.status);
    });

    client.test("Retrieved correct account details", function() {
        const expectedEmail = request.environment.get("email");
        const account = response.body[0];

        client.assert(account != null, "No account returned");

        client.assert(
            account.user_email === expectedEmail,
            `Expected ${expectedEmail}, got ${account.user_email}`
        );
    });
%}

