### Login
< {%
    // Wipe any leftover state from previous runs before logging in
    client.global.clearAll();
%}

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("Login successful", function () {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body.token !== undefined, "Token was not returned");
    });

    const accNum = response.body.user.accounts[0].account_number;
    client.log("Captured account number: " + accNum);
    client.log("Token: " + response.body.token);
    // Save details for later requests
    client.global.set("account_number", accNum);
    client.global.set("jwt", response.body.token);
    client.global.set("user_id", response.body.user.id);
%}