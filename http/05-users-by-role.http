### List by valid role
# @name List by valid role
POST {{host}}/api/users/admin/all
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "role_name": "CUSTOMER",
  "page_size" : 10,
  "page": 0
}

> {%
    client.test("Status is 200 OK", function() {
        client.assert(response.status === 200, "Expected status 200, got " + response.status);
    });

%}

### List by invalid role
# @name List by invalid role
POST {{host}}/api/users/admin/all
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "role_name": "XXX",
  "page_size" : 10,
  "page": 0
}

> {%
    client.test("Status is 404", function() {
        client.assert(response.status === 404, "Expected status 404, got " + response.status);
    });

%}